# OBIXCONFIGDOCTOR — local / production environment
# Copy to .env for local development. Never commit real secrets.

# Required in production: generate with python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
FLASK_DEBUG=0
FLASK_ENV=production
PORT=10000

# Set 1 only behind a trusted reverse proxy (Vercel / Render).
TRUST_PROXY=0
FORCE_INSECURE=0
BASE_URL=

# Persistent community ratings / likes: set a managed PostgreSQL URL in production.
# Example: postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=
# Local SQLite path (ignored by Git). On Vercel, absent DATABASE_URL falls back to ephemeral /tmp.
DATABASE_PATH=data/community.db

# Optional shared rate-limit store (recommended for multi-instance/serverless use).
REDIS_URL=

LOG_LEVEL=INFO
ENABLE_BLACKBOX_ANALYZER=1
ENABLE_RULE_ENGINE=1
ENABLE_SECRET_SAUCE=1
ENABLE_ADVANCED_ANALYSIS=1
